#!/bin/sh
# second-draft pre-commit hook — restyle AI-written staged content into your
# voice BEFORE it lands in git history.
#
# Install in any repo:
#   ln -s /path/to/second-draft/hooks/pre-commit .git/hooks/pre-commit
#   git config seconddraft.path /path/to/second-draft/second-draft.py
#   git config seconddraft.model qwen3:8b          # strongly recommended over 1B toys
#   git config seconddraft.check "npm test"        # repo's own gate; file reverts on red
#
# The legacy voicewash.* config keys are still read, so existing installs keep
# working.
#
# Skip a single commit:  SECOND_DRAFT=0 git commit ...   (VOICE_WASH=0 also works)
# Hooks are non-interactive, so this runs --yes: every hunk is auto-accepted IF
# it passes the guardrails (protected tokens, length band, prompt-leak check)
# and the --check command. Anything failing keeps/reverts to the original.

[ "$SECOND_DRAFT" = "0" ] && exit 0
[ "$VOICE_WASH" = "0" ] && exit 0

cfg() { git config "seconddraft.$1" || git config "voicewash.$1" || true; }

VW=$(cfg path)
[ -n "$VW" ] && [ -f "$VW" ] || { echo "second-draft: set 'git config seconddraft.path /path/to/second-draft.py' — skipping" >&2; exit 0; }

MODEL=$(cfg model); MODEL=${MODEL:-qwen3:8b}
BACKEND=$(cfg backend); BACKEND=${BACKEND:-ollama}
CHECK=$(cfg check)

if [ "$BACKEND" = "ollama" ]; then
    OLLAMA_BASE=$(cfg ollamahost); OLLAMA_BASE=${OLLAMA_BASE:-${OLLAMA_HOST:-http://localhost:11434}}
    curl -sf --max-time 2 "$OLLAMA_BASE/api/tags" >/dev/null 2>&1 || exit 0
elif [ "$BACKEND" = "moonshot" ]; then
    [ -n "$MOONSHOT_API_KEY" ] || exit 0
fi

CHANGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$CHANGED" ] && exit 0

CODE=$(echo "$CHANGED" | grep -E '\.(mjs|js|ts|py|go|rs)$' || true)
PROSE=$(echo "$CHANGED" | grep -E '\.md$' || true)

if [ -n "$CODE" ]; then
    echo "second-draft: restyling comments in staged source files" >&2
    if [ -n "$CHECK" ]; then
        echo "$CODE" | xargs python3 "$VW" --code --yes --backend "$BACKEND" --model "$MODEL" --check "$CHECK" || true
    else
        echo "$CODE" | xargs python3 "$VW" --code --yes --backend "$BACKEND" --model "$MODEL" || true
    fi
    echo "$CODE" | xargs git add
fi

if [ -n "$PROSE" ]; then
    echo "second-draft: restyling staged markdown" >&2
    for f in $PROSE; do
        python3 "$VW" --yes --backend "$BACKEND" --model "$MODEL" --in-place "$f" || true
        git add "$f"
    done
fi

exit 0
